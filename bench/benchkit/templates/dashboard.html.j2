<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --bg:#0d1117; --panel:#161b22; --border:#30363d; --fg:#e6edf3;
    --muted:#8b949e; --accent:#58a6ff; --win:#3fb950; --parity:#d29922;
    --reg:#f85149; --neg:#8b949e; --inc:#a371f7; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--fg);
    font:15px/1.55 -apple-system,"Segoe UI",Roboto,sans-serif; }
  .wrap { max-width:1100px; margin:0 auto; padding:2.5rem 1.25rem 4rem; }
  h1 { font-size:2rem; margin:0 0 .3rem; }
  h2 { font-size:1.05rem; margin:2rem 0 .7rem; color:var(--muted);
    text-transform:uppercase; letter-spacing:.08em; }
  .prov { color:var(--muted); font-size:.85rem; }
  .suite { display:block; background:var(--panel); border:1px solid var(--border);
    border-radius:10px; padding:1rem 1.1rem; margin:.6rem 0;
    text-decoration:none; color:inherit; }
  .suite:hover { border-color:var(--accent); }
  .suite .t { font-size:1.05rem; font-weight:600; }
  .suite .n { color:var(--muted); font-size:.82rem; margin-top:.15rem; }
  .badges { margin-top:.5rem; display:flex; flex-wrap:wrap; gap:.4rem; }
  .badge { font-size:.7rem; font-weight:700; letter-spacing:.05em;
    padding:.12rem .45rem; border-radius:999px; border:1px solid var(--border); }
  .b-win { color:var(--win); border-color:var(--win); }
  .b-parity { color:var(--parity); border-color:var(--parity); }
  .b-regression { color:var(--reg); border-color:var(--reg); }
  .b-negative { color:var(--neg); }
  .b-inconclusive { color:var(--inc); border-color:var(--inc); }
  .none { color:var(--muted); font-size:.85rem; }
  .foot { color:var(--muted); font-size:.78rem; margin-top:3rem; }
</style>
</head>
<body>
<div class="wrap">
  <h1>{{ title }}</h1>
  <p class="prov">generated {{ generated }} ·
    git <code>{{ git_sha }}</code>{{ " dirty" if git_dirty else " clean" }} ·
    {{ device }}</p>

  {% for category, suites in groups %}
  <h2>{{ category }}</h2>
  {% for s in suites %}
  <a class="suite" href="{{ s.page }}">
    <div class="t">{{ s.title }}</div>
    <div class="n">{{ s.suite }} · {{ s.ncells }} cells · {{ s.when }}</div>
    {% if s.findings %}
    <div class="badges">
      {% for f in s.findings %}
      <span class="badge b-{{ f.verdict }}">{{ f.badge }}</span>
      {% endfor %}
    </div>
    {% else %}
    <div class="none">no findings recorded</div>
    {% endif %}
  </a>
  {% endfor %}
  {% endfor %}

  <p class="foot">catopt benchkit dashboard · {{ nsets }} suites</p>
</div>
</body>
</html>
